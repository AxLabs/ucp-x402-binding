{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AxLabs/ucp-x402-binding/schema/handler.schema.json",
  "title": "org.x402 UCP Payment Handler Entry",
  "description": "Vendor-neutral x402 payment handler entry for UCP discovery. Facilitator detail is deliberately absent: the facilitator is merchant-side configuration.",
  "type": "object",
  "required": ["id", "version", "spec", "schema", "x402"],
  "properties": {
    "id": {
      "const": "org.x402.crypto"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "examples": ["1.0"]
    },
    "spec": {
      "type": "string",
      "format": "uri"
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "x402": {
      "type": "object",
      "required": ["networks", "assets"],
      "properties": {
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^eip155:[0-9]+$",
            "description": "CAIP-2 network reference. Examples: eip155:8453 (Base), eip155:47763 (Neo X), eip155:84532 (Base Sepolia)."
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["network", "asset", "decimals"],
            "properties": {
              "network": {
                "type": "string",
                "pattern": "^eip155:[0-9]+$"
              },
              "asset": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{40}$",
                "description": "ERC-3009-compatible token contract address. Must support transferWithAuthorization (exact scheme) or be Permit2-compatible."
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18
              },
              "symbol": {
                "type": "string",
                "maxLength": 11
              }
            }
          }
        },
        "maxAmount": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Ceiling for a single payment, integer base units (no decimals)."
        },
        "quoteWindow": {
          "type": "integer",
          "minimum": 60,
          "description": "Seconds a quoted total stays locked once issued. Default 600."
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["exact", "permit2"]
          },
          "description": "Accepted x402 schemes in preference order. Default: [\"exact\"]."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
